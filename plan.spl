; --- RULE METADATA ---

(meta r-ready-m4
  (description "Turn-loop integration needs the three primitives it composes")
  (justification "default turn-loop wires hooks (M2), dispatches tools (M3), runs in supervised process with mailbox (M1)"))

(meta r-ready-m7
  (description "Gateway needs supervision tree, receipt log, and CBCL parsing")
  (justification "WSS connection runs as a supervised child (M1), every accepted ask appends to receipt log (M5), inbound bytes are R1-R4 verified (M6)"))

(meta r-ready-m9
  (description "Image distribution needs the full functional surface present in heap before save-lisp-and-die")
  (justification ":clean t flush only audits real state; needs turn-loop (M4), gateway (M7), provider (M8) all loaded so the audit is meaningful"))

(meta r-ready-m11
  (description "Release smoke covers shutdown, image distribution, and reasoner together")
  (justification "drainable shutdown (REQ-012) requires all earlier surfaces; final smoke validates the full 2k harness end-to-end"))

(meta r-assign-m11
  (description "Final release is reviewer-driven, not impl-driven")
  (justification "milestone is verification of the full 2k budget against acceptance criteria; needs a reviewer who did not author the modules"))

