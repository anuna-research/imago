; =============================================================================
; IMPL-IMAGO-2K — Implementation Plan
; =============================================================================
; Decomposes the 2000-LOC variant of SPEC-011 (image-based agent harness) into
; twelve milestone tasks with dependency, readiness, and assignment rules.
; Greenfield SBCL Common Lisp project.
;
; Source spec: ~/Code/anuna-code/spec/SPEC-011-image-harness.md
; Variant: 2k LOC budget (FFI for CBCL, one provider, one supervision strategy,
;          optimization primitives deferred, two deprecated hooks dropped).
;
; Agent roles:
;   - architect : scaffolding, contract definitions, ADR translation
;   - impl      : SBCL implementation per milestone
;   - reviewer  : verification before milestone close

(meta plan
  (id "IMPL-IMAGO-2K")
  (title "anuna-imago — 2k LOC harness implementation")
  (version "0.1.0")
  (status "active")
  (created "2026-04-25")
  (spec "~/Code/anuna-code/spec/SPEC-011-image-harness.md")
  (description "Twelve milestones (M0 scaffold through M11 release) building the minimal-hackable-portable agent harness in SBCL Common Lisp. Each milestone gated on reviewer verification of the REQs and contracts it implements. Total budget approx 1830 LOC excluding tests; uses bordeaux-threads, dexador, websocket-driver, jzon, cffi, swank as deps. CBCL parser via FFI to cbcl-rs (resolves SPEC-011 open-Q-2). One provider (Anthropic). One supervision strategy (one-for-one). Optimization primitives and replay-as-API dropped per 2k cuts."))

; --- AGENTS ---
(given agent-architect-available)
(given agent-impl-available)
(given agent-reviewer-available)

; --- TASKS ---
(given task-m0-scaffold)
(given task-m1-core)
(given task-m2-hooks)
(given task-m3-tools)
(given task-m4-turn-loop)
(given task-m5-receipt-log)
(given task-m6-cbcl-ffi)
(given task-m7-gateway)
(given task-m8-anthropic)
(given task-m9-image)
(given task-m10-reasoner)
(given task-m11-release)

(given no-deps-m0-scaffold)

; --- TASK METADATA ---

(meta task-m0-scaffold
  (description "ASDF system definition (imago.asd) declaring all components and deps. src/packages.lisp with anuna-imago, anuna-imago.cbcl, anuna-imago.providers packages. src/main.lisp with agent-main entry point stub. README.md describing the project shape. LICENSE (Apache-2.0 to match anuna-code). architecture/ADR-001-image-runtime.md placeholder. Quality gate: (asdf:load-system :imago) compiles cleanly under SBCL with all listed deps available via Quicklisp.")
  (acceptance "asdf:load-system :imago succeeds. Package definitions parse. main.lisp stub prints version and exits.")
  (implements "scaffolding prerequisite")
  (loc-budget 80))

(meta task-m1-core
  (description "Core supervised actor primitives. mailbox.lisp (~80 LOC): bordeaux-threads queue with condvar, send/receive, peek, drain. supervisor.lisp (~250 LOC): one-for-one strategy only (other 3 deferred to v2 per 2k cut), restart counters with max-restarts and within window, child registry, supervisor introspection (list-children, query-state, force-restart, drain), graceful shutdown. agent.lisp (~120 LOC): defclass agent with id, capability, mailbox, supervisor, provider, tools, system-prompt, theory slots; defgenerics turn-loop, handle-message, on-spawn, on-shutdown with default methods.")
  (acceptance "Supervisor unit test: a child that signals on every Nth message restarts up to max-restarts then escalates to its parent. Mailbox round-trip test: send N, receive N in order. Agent CLOS smoke: instantiate, query slots, call defgenerics.")
  (implements "REQ-002 (one-for-one subset), partial REQ-004 (substrate)")
  (loc-budget 450))

(meta task-m2-hooks
  (description "Hook system at well-defined turn-loop and supervisor lifecycle points. hooks.lisp (~120 LOC): register-hook, remove-hook, run-hook primitives. Two semantics: sync-transformative (chained, first :veto aborts, returns transformed value) and fire-and-forget (dispatched on worker thread, run-hook returns immediately). Required keys: :on-user-input, :on-tool-call, :on-turn-complete, :on-agent-spawn, :on-agent-crash. Deprecated keys :on-prompt-build and :on-stream-token from spec REQ-005 explicitly NOT registered (2k cut, stance enforcement).")
  (acceptance "Hook ordering test: three sync-transform handlers run in registration order. Veto test: middle handler returning :veto aborts chain. Fire-and-forget timing test: hook sleep does not block run-hook caller.")
  (implements "REQ-005 (4-key subset), CON-003")
  (loc-budget 120))

(meta task-m3-tools
  (description "Tool definition + registry + provider-format conversion. tools.lisp (~150 LOC): define-tool macro accepting name, :description, :permission (:read | :write | :execute | :sensitive), :schema (param-name :type :required-p :description), :handler. Registry keyed by name. Schema-to-JSON-Schema converter for Anthropic format. Tools are CLOS-redefinable.")
  (acceptance "define-tool macro round-trip: define a tool, convert schema to Anthropic JSON Schema, parse a sample tool-call, dispatch handler. Schema property test: random tool definitions round-trip through JSON Schema without information loss.")
  (implements "REQ-006, CON-004")
  (loc-budget 150))

(meta task-m4-turn-loop
  (description "Default turn-loop method + stub provider + echo example. turn-loop.lisp (~150 LOC): defmethod turn-loop ((agent agent) ctx) wiring receive-message, :on-user-input hook, provider-stream loop, tool-call dispatch via :on-tool-call hook (Spindle invariant integration deferred to M10), :on-turn-complete fire-and-forget. providers/stub.lisp (~50 LOC): minimal canned-response provider for testing without network. examples/echo.lisp (~50 LOC): agent that replies 'echo: <input>'. Phase 1 quality gate: save-image! → boot → register → reply round-trip green against an in-process stub router.")
  (acceptance "Echo agent serves 100 asks against stub provider with no errors, no leaks. Turn-loop redefinition mid-flight (REQ-004) takes effect on next call. Spec Phase 1 quality gates green.")
  (implements "REQ-001 partial, REQ-007 partial (stub provider only)")
  (loc-budget 250))

(meta task-m5-receipt-log
  (description "Append-only content-addressed receipt log (no sqlite per 2k cut). receipt-log.lisp (~120 LOC): append-receipt!, schema (receipt-id, seq, direction, dialect, verb, content-hash, timestamp, agent-id, producer-id, status). Storage as line-oriented append-only file. Content-hash via ironclad (SHA-256 of canonical body). NO replay-as-API per 2k cut: reads happen via shell tools (tail/grep/jq).")
  (acceptance "1000 receipts appended in order, file is tail-readable, content hashes deduplicate identical bodies. Append latency p95 under 1ms.")
  (implements "REQ-010 (log subset; replay API dropped), OBS-001")
  (loc-budget 120))

(meta task-m6-cbcl-ffi
  (description "FFI binding to cbcl-rs (resolves SPEC-011 open question 2). cbcl-ffi.lisp (~80 LOC): cffi shim exposing parse-message, to-canonical, verify-r1-r4, message-receipt-id over a stable C ABI provided by cbcl-rs. Inherits 156/156 Lean oracle parity for free. NO in-CL parser per 2k cut. Build prerequisites documented: cbcl-rs cdylib reachable via load-foreign-library.")
  (acceptance "TEST-007 oracle parity: 156/156 vectors green. TEST-019 fuzz: 1M random inputs no crash/hang/divergence. parse-message returns CL data structure usable by gateway.lisp.")
  (implements "REQ-003, CON-002, NFR-005")
  (loc-budget 80))

(meta task-m7-gateway
  (description "CBCL Router Client implementation per CON-001. gateway.lisp (~250 LOC): WSS connection via websocket-driver, authenticate, register-capability, receive-ask, send-reply, heartbeat, disconnect. Wires receipt-log on every accepted ask + emitted reply. Capability registration is static per REQ-011 (sub-agent runtime re-registration dropped per my 2k review). Includes in-process stub router for tests so M4 echo agent can run without external dep.")
  (acceptance "Capability registration round-trip with cbcl-lfe-router instance. TEST-014 capability-based dispatch: agent A receives calendar:appointment, agent B does not, hot-deregister A causes fail-route. Heartbeat every 30s; reconnect on drop.")
  (implements "REQ-011 (static-only), CON-001")
  (loc-budget 250))

(meta task-m8-anthropic
  (description "Anthropic provider driver per CON-005. providers/anthropic.lisp (~250 LOC): defclass provider; methods build-request, parse-event, auth-headers; stream! primitive over dexador HTTP+SSE. Tool-call schema conversion via tools.lisp. Error model: provider errors surface as canonical-event :error with provider/status/retryable/body. NO Bedrock or Vertex per 2k cut (CON-005 contract preserved; second/third drivers in v2).")
  (acceptance "TEST-010 provider stub conformance to CON-005. Real Anthropic round-trip green for 100 turns at temperature 0. Tool-call dispatch end-to-end: agent calls a tool defined via define-tool, Anthropic returns tool_use, harness dispatches handler, result sent back.")
  (implements "REQ-007, CON-005")
  (loc-budget 250))

(meta task-m9-image
  (description "Image distribution per CON-008 — the load-bearing :clean t story. save-image.lisp + checklist as CHECKING.md. save-image! function: sb-ext:save-lisp-and-die wrapper with :toplevel #'agent-main, :clean t, :stripped nil. :clean t flushes per documented checklist: open sockets, in-progress receipts, ephemeral caches, env-loaded credentials, swank connections, debug instrumentation. CI scripts for darwin-arm64 and linux-x86_64 (darwin-x86_64 dropped per 2k cut, NFR-006 reduced).")
  (acceptance "TEST-006 image determinism: byte-identical artifacts on repeated save with no REPL activity. TEST-016 cold start P95 ≤ 200ms over 100 boots. TEST-017 image size ≤ 60MB minimal / ≤ 100MB full. :clean audit: grep saved image binary, no plaintext credentials or in-flight receipt bodies. CI matrix passes smoke on both platforms.")
  (implements "REQ-001 full, CON-008, NFR-001, NFR-002, NFR-006 (reduced)")
  (loc-budget 50))

(meta task-m10-reasoner
  (description "Spindle reasoner integration via IPC (in-process FFI dropped per 2k cut). reasoner.lisp (~80 LOC): load-theory, assert-fact!, retract-fact!, query, what-if, why-not over IPC to spindle-rs service. Wired into hooks.lisp at :on-tool-call as invariant filter only — capability-augmenting use explicitly blocked per Stance.")
  (acceptance "TEST-011 invariant filter: 'never call delete-user without confirmation' theory blocks 100% of attempts. Reasoner query latency P95 ≤ 10ms over IPC. Negative-test corpus of denied operations: 100% denial rate.")
  (implements "REQ-008, CON-006")
  (loc-budget 80))

(meta task-m11-release
  (description "Drainable shutdown + end-to-end release smoke. REQ-012 implementation in supervisor + gateway: refuse new asks (capability unregister), continue serving in-flight to NFR-009 30s timeout, persist heap to designated location, exit with :drained or :forced status. End-to-end smoke: build image, boot against real router, serve 50 concurrent asks, SIGTERM, verify drain, persistent recovery checkpoint readable, status code correct. Final two-platform CI matrix.")
  (acceptance "TEST-015 drainable shutdown: capability deregisters within 100ms, in-flight asks complete, new asks rejected, exit code :drained within 30s. CI smoke green on darwin-arm64 and linux-x86_64. Manual review of full LOC budget: under 2000 lines (excluding tests, deps, examples).")
  (implements "REQ-012, NFR-006, NFR-009")
  (loc-budget 50))

