(given task-t10-persistence)
(given task-t11-tests)
(given task-t12-review)

; =============================================================================
; TASK METADATA
; =============================================================================

(meta task-d00-adversarial-review
  (description "Fresh-context adversarial review of CON-002 (pre-filter denylist) and CON-003 (reasoner floor invariants + safety-layer generics set). Reviewer mandate per spec Stance section: 'find a sequence of harness-eval calls that defeats the safety stack'. Output: written report with at minimum (a) confirmation of the safety-layer generics set (additions/removals), (b) any bypass shape not covered by CON-002, (c) any rule omission in the floor invariants. Asserts (given decided-d00-adversarial-review) when complete and any spec amendments are merged.")
  (acceptance "Review report committed under architecture/ADR-012-self-mod-adversarial-review.md or equivalent. Spec amended if review surfaces gaps. Without this fact, no IMPL task may start (gate per Stance §Anti-Slop).")
  (implements "spec Stance / Anti-Slop / Adversarial Review")
  (gates "all impl tasks"))

(meta task-d01-timeout-mechanism
  (description "Decide OQ-001: SBCL with-timeout (SIGALRM, heap-unsafe) vs worker-thread + terminate-thread (heap-safe, ~ms overhead). Spec recommends worker-thread. Output: ADR-006 documenting the chosen mechanism and the failure modes it does NOT cover.")
  (acceptance "ADR-006 file present. Decision asserted as (given decided-d01-timeout-mechanism). Handler implementation (t07) reads from this decision.")
  (implements "OQ-001 → ADR-006"))

(meta task-d02-package-isolation
  (description "Decide OQ-002: accept that an agent can (in-package :anuna-imago) inside a submitted form (option a, recommended) vs strip top-level in-package calls (option b). Spec recommends a. Output: ADR-007 documenting the decision and the operator-facing wording for what the :package argument actually buys.")
  (acceptance "ADR-007 file present. Decision asserted as (given decided-d02-package-isolation). Pre-filter (t02) and handler (t07) align with the chosen behaviour.")
  (implements "OQ-002 → ADR-007"))

(meta task-d03-result-serialisation
  (description "Decide OQ-003: bound prin1 with *print-circle*, *print-length*, *print-level*, and a 4 KB truncation (recommended) vs a stricter type whitelist. Spec recommends bounding without whitelist. Output: ADR-008 with concrete values for the print-* specials and the truncation threshold.")
  (acceptance "ADR-008 file present. Decision asserted as (given decided-d03-result-serialisation). Handler (t07) reads the values from this ADR or a constant in the handler module that cites the ADR.")
  (implements "OQ-003 → ADR-008"))

(meta task-d04-non-method-rollback
  (description "Decide OQ-004: extend *rollback-register* to capture prior symbol-function for defun (recommended) and document defparameter as best-effort. Output: REQ-013 amendment to SPEC-012 OR an ADR-009 if amendment is rejected, plus updated CON-006 record shape if the extension is taken.")
  (acceptance "Spec or ADR file updated. Decision asserted as (given decided-d04-non-method-rollback). Rollback register implementation (t06) and origin index (t05) reflect the decision.")
  (implements "OQ-004 → REQ-013 (proposed) or ADR-009"))

(meta task-t01-scaffold
  (description "Bring the file skeleton into existence. Adds src/self-modification.lisp (empty defpackage-respecting file with section headers per CON-001..CON-006), examples/self-modifying.lisp (empty install function stub returning :not-implemented), theories/ directory with self-modification-floor.spl skeleton, test/m12-tests.lisp skeleton. Updates imago.asd with the new src component (DOES NOT register self-modifying.lisp under examples since registration must remain explicit per REQ-001). Updates packages.lisp to export the new public API symbols (harness-eval, install-self-modification-tools!, *redefine-history*, redefine-history, last-redefinition, all-redefined-symbols, *rollback-register*, rollback!, rollback-records, find-rollback-records-for, %harness-eval-prefilter, %harness-eval-handler, %lift-form). NO behaviour yet — this is the seam.")
  (acceptance "(asdf:load-system :imago) compiles cleanly with the new src/self-modification.lisp loaded. test/m12-tests.lisp compiles. Default tool list (TEST-001 / TEST-017) still matches baseline — the install function exists but does nothing yet.")
  (implements "structural prerequisite for REQ-002, REQ-007, REQ-008")
  (loc-budget "~80 LOC of scaffolding"))

(meta task-t02-prefilter
  (description "Implement %harness-eval-prefilter per CON-002. Pure structural inspector: given a CL form, returns :pass or (:rejected :rule <kw> :reason <str>). Top-level operator denylist enumerated in CON-002 table; defmethod against any safety-layer generic also rejected. Does NOT macroexpand. Does NOT walk body. Threaded by *prefilter-denylist* defparameter so the rules are inspectable from the REPL. Also exports %prefilter-rule-keywords for tests.")
  (acceptance "TEST-005 passes (one example per CON-002 row). %harness-eval-prefilter is itself in the safety-layer generics set so it cannot be redefined by the port. The denylist is a defparameter, not hard-coded inside a defun, so operators can inspect the floor.")
  (implements "REQ-004, CON-002, REQ-010 (a)–(c)")
  (loc-budget "~80 LOC"))

(meta task-t03-lift
  (description "Implement %lift-form per CON-003. Given a parsed CL form (post-prefilter), produce the plist (:operator :target :qualifier :specialisers :free-symbols). Free-symbol extraction is a single pass: collect symbols in functional position (car of each form recursively) plus first arg of funcall/apply. NO macroexpansion. NO eval. Pure function so it can be unit-tested without harness state. Docstring cites CON-003 verbatim for the expected shape.")
  (acceptance "TEST-006 property 1 passes: forms differing only in whitespace/comments/package prefixes produce equal plists. TEST-006 property 2 passes: forms with different bodies or targets produce non-equal plists. Test corpus includes the HP-003 narrow defmethod, the TEST-015 progn composite, defun, defparameter, and a defmacro form.")
  (implements "REQ-005 (lift portion), CON-003 lift contract")
  (loc-budget "~120 LOC"))

(meta task-t04-receipt
  (description "Implement %tool-receipt! per CON-004. Writes a fixed-shape plist entry to the harness-eval audit log: :tool, :agent-id, :timestamp, :form (verbatim), :result-phase, :result-tag, :elapsed-ms, :result-summary. Reuses the receipt-log machinery (open/close/append) from src/receipt-log.lisp BUT with a separate log-file path (default: alongside the SPEC-011 receipt log) so SPEC-011 receipt-shape invariants are not perturbed. Registers the log via register-receipt-log-for-clean! so save-image! flushes it. Verbatim form NEVER truncated/normalised; large prin1 values written to a content-addressed binary side-channel and referenced by sha-256 hex from :result-summary.")
  (acceptance "TEST-007 passes: a form with leading comment is recorded byte-identical. The audit log file is opened on install, registered for save-clean. Reads via read-receipts return the plist intact. Side-channel large values round-trip through their hash.")
  (implements "REQ-006, CON-004")
  (loc-budget "~150 LOC"))

(meta task-t05-origin-index
  (description "Implement *redefine-history* and the public API per CON-005. Hash-table symbol → list-of-events, most-recent-first. Event shape exactly per CON-005. Verbatim form preserved when ≤500 bytes; sha-256 hex otherwise. Public functions: redefine-history, last-redefinition, all-redefined-symbols. Internal: %record-definition!. Records when the evaluated form's top-level operator is one of: defun defmethod defgeneric defmacro defparameter defvar defclass defstruct. The decision from t-d04 may extend this set or its rollback linkage.")
  (acceptance "TEST-008 passes: three sequential redefinitions of f produce three events in order with correct prior-spec. NFR-005 / TEST-022 storage budget: ≤2 KB per event when verbatim ≤500 bytes; query latency p95 ≤10 ms at 10⁴ entries.")
  (implements "REQ-007, CON-005")
  (loc-budget "~120 LOC"))

(meta task-t06-rollback
  (description "Implement *rollback-register* and the public API per CON-006. Vector of records pushed when an evaluated form redefines a method. Captures the prior method object via find-method BEFORE installation. Public functions: rollback!, rollback-records, find-rollback-records-for. rollback! re-installs prior method (or remove-method if prior was nil), enters its own receipt-log entry tagged :result-phase :rollback, and pushes a new origin-index event with :agent-id :rollback. Per t-d04 decision, may also handle defun rollback by capturing prior symbol-function.")
  (acceptance "TEST-009 passes: a method redefined via harness-eval is restored by (rollback! 0); the rollback itself appears in the receipt log and origin index. Rollback of a method that had no prior calls remove-method, not install.")
  (implements "REQ-008, CON-006")
  (loc-budget "~150 LOC"))

(meta task-t07-handler
  (description "Implement %harness-eval-handler — the orchestrator. For each call: (1) parse form via read-from-string in a controlled package; (2) %harness-eval-prefilter; (3) on pass, %lift-form, assert per-call facts in the active theory under unwind-protect, query (forbidden eval-call <form-id>), retract; (4) on -Δ/-∂, evaluate the form under the timeout mechanism chosen in t-d01 in the package chosen per t-d02 with print-* bounds per t-d03; (5) capture prior method (delegating to t06) iff defmethod; (6) call %record-definition! iff a definition operator; (7) %tool-receipt! at every termination point. Always returns a structured plist per CON-001 — never raises to the caller. The handler is itself in the safety-layer generics set.")
  (acceptance "TEST-002, TEST-003 (all four sub-cases), TEST-004 (property over all four phases) pass. NFR-001 latency budget: p95 ≤100 ms over 1000 calls of a 50-form defmethod with reasoner stub. Audit completeness (NFR-002 sampling): 100% receipt-log entries vs tool-call frames.")
  (implements "REQ-002, REQ-003, CON-001")
  (loc-budget "~250 LOC"))

(meta task-t08-theory-floor
  (description "Author theories/self-modification-floor.spl per CON-003. Contains: safety-layer-generic/1 facts (9 names enumerated in CON-003), the six floor-invariant rules over forbidden(eval-call,F), and the predicate-arity declarations Spindle needs to parse defmethod-targets/2, defun-targets/2, mentions/2 without unknown-predicate errors at query time. Also writes a separate fixture theories/self-mod-test-stub.spl used by tests where the reasoner is stubbed to return canned results without an actual Spindle service.")
  (acceptance "Loading the floor theory via load-theory-from-file produces a non-nil handle. install-self-modification-tools! verification check (CON-003 'floor-invariants-missing') passes when the floor is loaded; fails when an empty theory is loaded.")
  (implements "REQ-005, CON-003")
  (loc-budget "~50 lines of SPL"))

(meta task-t09-install-fn
  (description "Author examples/self-modifying.lisp per REQ-001. Defines (install-self-modification-tools!): pushes :eval onto *valid-permissions*, ensures :anuna-imago-user package exists with (:use :cl :anuna-imago), verifies a theory handle is bound and contains the floor invariants (CON-003), opens the harness-eval audit receipt log, registers it for clean, then registers harness-eval as a tool with permission :eval and handler #'%harness-eval-handler. Also defines (uninstall-self-modification-tools!): unregister tool, close audit log, optionally remove :eval from *valid-permissions* if no other tool uses it. Ships with a brief operator README inline.")
  (acceptance "TEST-001 passes: default agent has no harness-eval. TEST-010 passes: :eval permission honoured by policy denial. TEST-017 passes: default tool list unchanged. (load \"examples/self-modifying.lisp\") then (install-self-modification-tools!) succeeds; without a loaded theory it returns :no-active-theory.")
  (implements "REQ-001, REQ-009, REQ-012")
  (loc-budget "~100 LOC"))

(meta task-t10-persistence
  (description "Wire the save-image! survival path per REQ-011. Audit log goes through register-receipt-log-for-clean! (already done in t04). The active theory handle, *redefine-history*, *rollback-register*, the registered tool, and the wired hook are all in the saved heap by virtue of being defvar/defparameter or registry entries. Add a smoke test that saves an image with the port installed, boots the binary in a sub-SBCL, and confirms list-tools, the theory handle, *redefine-history*, *rollback-register* are all populated.")
  (acceptance "TEST-016 passes: persistence integration test boots the saved image via uiop:run-program and verifies the four artefacts are present. No new code in save-image.lisp — the seam is already correct.")
  (implements "REQ-011")
  (loc-budget "~30 LOC of integration test only"))

(meta task-t11-tests
  (description "Complete the test corpus for SPEC-012 in test/m12-tests.lisp. Includes: TEST-001 default no harness-eval; TEST-002 evaluated value; TEST-003 three rejection shapes; TEST-004 property-based over all four phases; TEST-005 prefilter denylist coverage (one per CON-002 row); TEST-006 lift stability + leak-free unwind-protect (1000 calls); TEST-007 verbatim receipt; TEST-008 origin-index ordering; TEST-009 rollback round-trip; TEST-010 :eval permission; TEST-011..TEST-015 recursion-safety (five sub-cases); TEST-016 persistence (driven by t10); TEST-017 default tool list unchanged; TEST-018 latency p95; TEST-019 audit completeness sampling (short-window stand-in for 30 days); TEST-020 prefilter false-positive rate against a 1000-form corpus (corpus authored here); TEST-021 reasoner adjudication latency; TEST-022 origin-index storage and query latency. Reasoner is stubbed via *reasoner-ipc-call* throughout (no real Spindle dep at unit-test time).")
  (acceptance "asdf:test-system :imago green for the m12-tests component. Test count ≥22 distinct test definitions corresponding to TEST-001..TEST-022. The 1000-form corpus is committed under test/fixtures/spec-012-corpus.lisp so the false-positive metric is reproducible.")
  (implements "TEST-001..TEST-022, NFR-001..NFR-005")
  (loc-budget "~600 LOC of tests + ~200 LOC corpus"))

(meta task-t12-review
  (description "Final review against the safety-stack threat model. Reviewer rebuilds the spec's threat model from CON-002 / CON-003 in their own words, runs the recursion-safety subset (TEST-011..TEST-015) under -O0 and -O3 (compiled vs interpreted), and attempts at least three new bypass shapes not enumerated in the spec or t-d00 review. Documents findings in architecture/SELF-MOD-REVIEW.md. The review either green-lights merge or files a blocker that loops back to t-d00.")
  (acceptance "Review document committed. All safety-stack tests green under both compilation modes. No filed blockers, or all blockers resolved.")
  (implements "spec Stance / Anti-Slop closing review"))

