; =============================================================================
; RULE METADATA — explain the non-obvious dependencies
; =============================================================================

(meta r-ready-t01
  (description "Scaffold blocks on the adversarial review only — not on any of the OQ decisions, because the file skeleton doesn't bind any runtime policy.")
  (justification "Spec Stance §Anti-Slop: 'this spec MUST be reviewed in a fresh context against the threat models in CON-002 and CON-003 before any IMPL plan begins'."))

(meta r-ready-t02
  (description "Pre-filter binds on d02 because the package-isolation decision may add or remove an in-package strip rule.")
  (justification "OQ-002 explicitly couples to the pre-filter: option (b) would put an in-package strip in the denylist; option (a) explicitly does not."))

(meta r-ready-t05
  (description "Origin index binds on d04 because the event record may need a defun-rollback link.")
  (justification "OQ-004 may extend rollback to defun, which would make the origin-index event carry a :rollback-ref for non-method definitions too."))

(meta r-ready-t06
  (description "Rollback register binds on d04 — the decision IS about its scope.")
  (justification "OQ-004 directly determines whether *rollback-register* captures non-method redefinitions."))

(meta r-ready-t07
  (description "Handler binds on d01, d02, d03 because all three are runtime policies the handler enforces.")
  (justification "d01 = how the handler enforces :timeout. d02 = which package the handler reads-and-evaluates in. d03 = how the handler renders the result string."))

(meta r-ready-t12
  (description "Final review is reviewer-driven, not impl-driven.")
  (justification "Per spec Stance §Anti-Slop closing review, the recursion-safety subset must be re-verified by an independent reviewer attempting fresh bypass shapes."))

