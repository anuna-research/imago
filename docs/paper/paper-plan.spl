; =============================================================================
; PAPER-IMAGO — Drafting plan for a short academic paper based on anuna-imago
; =============================================================================
; Goal: a short (4–6 page) paper presenting anuna-imago's most novel
; contribution. Coordinated via hence so that scope is locked before
; drafting, and prose is reviewed before assembly.
;
; Agents:
;   - me    : the LLM drafter (researches, outlines, drafts prose)
;   - hugo  : the project author / reviewer (validates scope and key claims)
;
; Plan is intentionally small — each task is a coherent half-day of work,
; and dependencies enforce the right ordering (scope first, lit review and
; outline before drafts, drafts before assembly, assembly before format).

(meta plan
  (id "PAPER-IMAGO")
  (title "anuna-imago — short academic paper")
  (version "0.1.0")
  (status "active")
  (created "2026-04-28")
  (description "Draft a short academic paper based on the anuna-imago project. Working assumption: the paper's contribution is defeasible-logic-gated self-modification for LLM agents — three-layer safety stack (pre-filter / reasoner / handler), with empirical evidence from the EXPERIMENT-LOG.md runs. Final scope is the first task and must be approved before any drafting begins."))

; -----------------------------------------------------------------------------
; AGENTS
; -----------------------------------------------------------------------------

(given agent-me-available)
(given agent-hugo-available)

; -----------------------------------------------------------------------------
; TASKS
; -----------------------------------------------------------------------------

(given task-scope)                  ; pin down thesis, venue, length, audience
(given task-lit-review)             ; survey adjacent literature
(given task-outline)                ; section-by-section outline with claims
(given task-draft-intro)            ; abstract + introduction
(given task-draft-bitter-lesson)    ; §2 the bitter lesson applied to runtimes
(given task-draft-substrate)        ; §3 amputable substrate principles
(given task-draft-existence-proof)  ; §4 anuna-imago as existence proof
(given task-draft-related)          ; §5 related stances
(given task-draft-discussion)       ; §6 conclusion (also: limitations)
(given task-review-scope)           ; hugo approves scope
(given task-review-claims)          ; hugo validates technical claims after drafts land
(given task-assemble)               ; coherence pass: transitions, voice, length
(given task-format-final)           ; pandoc → LaTeX → PDF, build refs.bib

; Initial readiness — only `scope` has no deps.
(given no-deps-scope)

; =============================================================================
; TASK METADATA
; =============================================================================

(meta task-scope
  (description "Determine the paper's thesis, venue, target length, and audience. Working hypothesis: contribution is defeasible-logic-gated self-modification with empirical backing. Output: a one-page scope doc at docs/paper/SCOPE.md covering thesis statement, target venue (workshop/blog/preprint), audience (PL/AI/safety), length cap (pages or words), and excluded scope.")
  (acceptance "docs/paper/SCOPE.md committed; reviewed and approved by hugo (task-review-scope)."))

(meta task-review-scope
  (description "Hugo reviews the scope doc and approves or requests changes. Asserts (given approved-scope) when ready to gate the rest of the work.")
  (acceptance "Hugo confirms scope is correct; (given approved-scope) asserted."))

(meta task-lit-review
  (description "Survey related work in three threads: (1) LLM agent safety (function-call gating, sandboxing, capability lattices), (2) self-modifying programs (Smalltalk image, MetaCircular, Schism — and recent LLM-driven code-edit agents), (3) defeasible logic in AI (Antoniou, Maher; Spindle/SPINdle implementations). Goal: 10–15 citations identifying what's novel here. Output: docs/paper/LIT-REVIEW.md with annotated bibliography.")
  (acceptance "Bibliography of 10+ entries, each with 1-2 sentence relevance note. Identifies the strongest 3 prior works the paper should explicitly position against."))

(meta task-outline
  (description "Produce a section-by-section outline with one bulleted claim per paragraph. Sections: abstract, intro, background, system, evaluation, related, discussion, conclusion. Each section has a target word/page count summing to the agreed length. Output: docs/paper/OUTLINE.md.")
  (acceptance "Outline covers all sections; per-paragraph claims are concrete (not 'discuss X' but 'we show that X')."))

(meta task-draft-intro
  (description "Draft title + abstract + introduction. Working title: 'The amputable substrate: agent runtimes designed against the bitter lesson'. ~150 words abstract + ~400 words intro. Frames the problem: agent runtimes embedding model-capability assumptions age badly. State the thesis upfront. Output: docs/paper/sections/01-intro.md.")
  (acceptance "Abstract under 200 words. Intro under 450 words. Thesis is in the first paragraph."))

(meta task-draft-bitter-lesson
  (description "Draft §2: the bitter lesson, applied to runtimes. ~400 words. Argue with named examples that current frameworks have already paid migration cost for assumptions that aged badly — planner modules superseded, prompt templates replaced by tool-use, output parsers replaced by structured outputs. Cite Sutton 2019. Output: docs/paper/sections/02-bitter-lesson.md.")
  (acceptance "At least 3 concrete framework-decision-that-aged-badly examples. Cites Sutton's bitter-lesson essay. Argument is structural, not roasting specific tools by name."))

(meta task-draft-substrate
  (description "Draft §3: the amputable substrate principles. ~500 words. Three principles, each ~150 words: (i) every layer redefinable at runtime without restart, (ii) the artifact IS the heap (image distribution), (iii) safety from invariants, not pipelines. Each principle states the consequence — what design decisions follow, what they refuse to encode. Output: docs/paper/sections/03-substrate.md.")
  (acceptance "Three principles, each with consequence-paragraph. No implementation details — pure architectural argument."))

(meta task-draft-existence-proof
  (description "Draft §4: anuna-imago as existence proof. ~400 words. Cite scope (~4100 LOC), substrate (SBCL CLOS + save-lisp-and-die), and one worked example: live redefinition of provider-stream! surviving an image save. Brief one-paragraph nod to the SPEC-012 self-modification port as a concrete instance of 'safety from invariants.' Not a product pitch — explicitly note the cost (CL/SBCL lock-in). Output: docs/paper/sections/04-existence-proof.md.")
  (acceptance "Includes the worked redefinition example. Acknowledges the SBCL/CL cost. Under 450 words."))

(meta task-draft-related
  (description "Draft §5: related stances. ~250 words. Position against (a) the Smalltalk image lineage / Lisp Machines (similar substrate spirit, different problem domain), (b) recent agent-framework critiques in the AI-engineering blogosphere, (c) capability-routing literature in distributed systems. Output: docs/paper/sections/05-related.md.")
  (acceptance "At least 3 distinct positioning anchors. Each cited with a one-line distinction."))

(meta task-draft-discussion
  (description "Draft §6: conclusion. ~100 words. Concise restatement; acknowledge the wager (this position could be wrong if model capability plateaus). Output: docs/paper/sections/06-conclusion.md.")
  (acceptance "Under 150 words. Honest about the wager."))

(meta task-review-claims
  (description "Hugo reads the system + eval drafts and validates technical claims. Specifically: are the three layers described correctly, do the EXPERIMENT-LOG numbers match, are the safety-layer-symbols category descriptions accurate. Asserts (given approved-claims) when validated.")
  (acceptance "Hugo confirms or corrects the technical content; (given approved-claims) asserted."))

(meta task-assemble
  (description "Stitch the section drafts into a single document. Smooth transitions, eliminate duplication, ensure consistent voice and tense (past for empirical, present for system description). Length-check against the cap. Output: docs/paper/draft.md.")
  (acceptance "Single coherent document under the agreed length cap."))

(meta task-format-final
  (description "Apply the chosen venue's style (LaTeX, Markdown for blog, etc.). Build the BibTeX file from the lit review. Final proofread. Output: docs/paper/final.{tex,md} + docs/paper/refs.bib.")
  (acceptance "Compiles / renders cleanly. All citations resolve."))

; =============================================================================
; READINESS RULES — encode dependencies
; =============================================================================

; Scope is ready immediately.
(normally r-ready-scope
  (and task-scope no-deps-scope)
  ready-scope)

; Hugo's scope review unlocks once scope is drafted.
(normally r-ready-review-scope
  (and task-review-scope completed-scope)
  ready-review-scope)

; Lit review and outline both gate on approved scope.
(normally r-ready-lit
  (and task-lit-review approved-scope)
  ready-lit-review)
(normally r-ready-outline
  (and task-outline approved-scope)
  ready-outline)

; Drafts gate on outline AND lit-review (so they have structure + sources).
(normally r-ready-draft-intro
  (and task-draft-intro completed-outline completed-lit-review)
  ready-draft-intro)
(normally r-ready-draft-bitter-lesson
  (and task-draft-bitter-lesson completed-outline completed-lit-review)
  ready-draft-bitter-lesson)
(normally r-ready-draft-substrate
  (and task-draft-substrate completed-outline completed-lit-review)
  ready-draft-substrate)
(normally r-ready-draft-existence-proof
  (and task-draft-existence-proof completed-outline completed-lit-review)
  ready-draft-existence-proof)
(normally r-ready-draft-related
  (and task-draft-related completed-outline completed-lit-review)
  ready-draft-related)
(normally r-ready-draft-discussion
  (and task-draft-discussion completed-outline completed-lit-review)
  ready-draft-discussion)

; Hugo's claims review gates on the two anuna-imago-specific drafts:
; the substrate principles (architectural claims) and the existence proof
; (factual claims about the codebase).
(normally r-ready-review-claims
  (and task-review-claims completed-draft-substrate completed-draft-existence-proof)
  ready-review-claims)

; Assembly gates on ALL drafts complete + claims approved.
(normally r-ready-assemble
  (and task-assemble
       completed-draft-intro
       completed-draft-bitter-lesson
       completed-draft-substrate
       completed-draft-existence-proof
       completed-draft-related
       completed-draft-discussion
       approved-claims)
  ready-assemble)

; Final formatting gates on assembly.
(normally r-ready-format
  (and task-format-final completed-assemble)
  ready-format-final)

; =============================================================================
; ASSIGNMENT RULES — me drafts, hugo reviews
; =============================================================================

; Drafting tasks → me
(normally r-assign-scope-me        (and ready-scope agent-me-available)             assign-to-scope-me)
(normally r-assign-lit-me          (and ready-lit-review agent-me-available)        assign-to-lit-review-me)
(normally r-assign-outline-me      (and ready-outline agent-me-available)           assign-to-outline-me)
(normally r-assign-intro-me           (and ready-draft-intro agent-me-available)            assign-to-draft-intro-me)
(normally r-assign-bitter-lesson-me   (and ready-draft-bitter-lesson agent-me-available)    assign-to-draft-bitter-lesson-me)
(normally r-assign-substrate-me       (and ready-draft-substrate agent-me-available)        assign-to-draft-substrate-me)
(normally r-assign-existence-proof-me (and ready-draft-existence-proof agent-me-available)  assign-to-draft-existence-proof-me)
(normally r-assign-related-me         (and ready-draft-related agent-me-available)          assign-to-draft-related-me)
(normally r-assign-discussion-me      (and ready-draft-discussion agent-me-available)       assign-to-draft-discussion-me)
(normally r-assign-assemble-me     (and ready-assemble agent-me-available)          assign-to-assemble-me)
(normally r-assign-format-me       (and ready-format-final agent-me-available)      assign-to-format-final-me)

; Review tasks → hugo
(normally r-assign-review-scope    (and ready-review-scope agent-hugo-available)    assign-to-review-scope-hugo)
(normally r-assign-review-claims   (and ready-review-claims agent-hugo-available)   assign-to-review-claims-hugo)

; =============================================================================
; RULE METADATA — capture intent
; =============================================================================

(meta r-ready-draft-intro
  (description "Drafts only start once we have an outline AND a literature pool to cite from")
  (justification "Avoids drafting prose with no idea what we're claiming or what we're citing"))

(meta r-ready-assemble
  (description "Assembly waits for ALL drafts and Hugo's claims review")
  (justification "Cheaper to fix technical errors before stitching than after"))

